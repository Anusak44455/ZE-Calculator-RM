          )}
          {error && (
            <div className="error-banner"><AlertCircle size={15} /><span>{error}</span></div>
          )}
        </div>

        <div className="card">
          <h3>2 · รายการชิ้นงาน</h3>
          {rows.length === 0 ? (
            <div className="empty-hint">ยังไม่มีรายการ — อัปโหลดภาพด้านบน หรือกด “เพิ่มแถว” เพื่อกรอกเอง</div>
          ) : (
            <table>
              <thead>
                <tr><th>ART</th><th>กว้าง (มม)</th><th>สูง (มม)</th><th>จำนวน</th><th>ตร.ม</th><th></th></tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr key={r.id}>
                    <td><input type="text" value={r.art} onChange={(e) => updateRow(r.id, "art", e.target.value)} /></td>
                    <td><input type="number" value={r.width || ""} onChange={(e) => updateRow(r.id, "width", e.target.value)} /></td>
                    <td><input type="number" value={r.height || ""} onChange={(e) => updateRow(r.id, "height", e.target.value)} /></td>
                    <td><input type="number" min="0" className="qty-input" value={r.qty ?? 1} onChange={(e) => updateRow(r.id, "qty", e.target.value)} /></td>
                    <td className="sqm-cell">{fmt(r.sqm)}</td>
                    <td><button className="del-btn" onClick={() => removeRow(r.id)}><Trash2 size={15} /></button></td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
          <div className="table-foot">
            <button className="add-btn" onClick={addRow}><Plus size={14} /> เพิ่มแถว</button>
            {rows.length > 0 && <button className="clear-link" onClick={clearAll}>ล้างทั้งหมด</button>}
          </div>
        </div>

        <div className="card">
          <h3>3 · สรุปจำนวนไม้ · {modeInfo.label}</h3>
          <div className="ticket">
            <div>
              <div className="t-label">รวมพื้นที่ทั้งหมด</div>
              <div className="t-sqm">{fmt(totalSqm)} ตร.ม</div>
            </div>
            <div className="t-count">
              {sheetCount || 0}
              <span>แผ่น (เผื่อ 10%)</span>
            </div>
          </div>
          <div className="ticket-actions">
            <button className="add-btn" onClick={() => syncQty(sheetCount)}>
              <Ruler size={13} /> ใช้ค่านี้ในการจองไม้ด้านล่าง
            </button>
            {(rows.length > 0 || sheetCount > 0) && (
              <button className="reset-btn" onClick={resetAll}>
                <RotateCcw size={13} /> เริ่มคำนวณใหม่
              </button>
            )}
          </div>
        </div>

        <div className="card">
          <h3>4 · คำนวณการจองไม้ในแอป</h3>
          <div className="unit-grid">
            <UnitCard title="หน่วย PC" unit="PC" qty={qtyPC} setQty={setQtyPC} />
            <UnitCard title="หน่วย M" unit="M" qty={qtyM} setQty={setQtyM} convertFactor={3} convertLabel="M" />
            <UnitCard title="หน่วย M2" unit="M2" qty={qtyM2} setQty={setQtyM2} convertFactor={6} convertLabel="M2" />
          </div>
        </div>

        <div className="card">
          <h3>5 · เช็ค RM</h3>
          <a
            className="rm-link"
            href="https://www.appsheet.com/start/6698d0de-6511-4853-ae8e-4677587319fa#appName=ZRMProgram-6114214&page=form&row=onlyvalue&table=_Per+User+Settings&view=Settings"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>
              <span className="rm-link-title">เปิด ZRM Program (AppSheet)</span>
              <span className="rm-link-sub">ใช้เช็คยอด RM คงเหลือก่อนจอง</span>
            </span>
            <ExternalLink size={18} />
          </a>
        </div>
      </div>
    </div>
  );
}
