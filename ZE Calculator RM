/* ────────────────────────────────────────────────────────────────
   สูตรอ้างอิงจากไฟล์ "สูตรการคำนวณไม้เพื่อจอง RM ZE 2026.xlsx"
   ต่อชิ้น :  ตร.ม = (กว้าง × สูง) / 1,000,000
   รวมแผ่นไม้ :  ROUNDUP( รวมตร.ม / พื้นที่แผ่น × 1.1 , 0 )
     - ไม้ 4x8  (1200×2400 มม)  → พื้นที่แผ่น 2.88 ตร.ม
     - ไม้ 6x8  (1800×2400 มม, panel plus) → พื้นที่แผ่น 4.32 ตร.ม
   จองไม้ในแอป (จากจำนวนไม้ที่ได้) :
     - PC : เผื่อ = จำนวนไม้×0.3        , สั่ง = ROUNDUP(จำนวนไม้ + เผื่อ×1.1)
     - M  : แปลง = จำนวนไม้×3           , เผื่อ = แปลง×0.3 , สั่ง = ROUNDUP(แปลง+เผื่อ×1.1)
     - M2 : แปลง = จำนวนไม้×6           , เผื่อ = แปลง×0.3 , สั่ง = ROUNDUP(แปลง+เผื่อ×1.1)
   ──────────────────────────────────────────────────────────────── */

const MODES = {
  "4x8": { label: "ไม้ 4x8", dims: "1,200 × 2,400 มม", area: 2.88, maxW: 1200, maxH: 2400 },
  "6x8": { label: "ไม้ 6x8", dims: "1,800 × 2,400 มม (panel plus)", area: 4.32, maxW: 1800, maxH: 2400 },
};

const roundup = (n) => Math.ceil(n - 1e-9);
const fmt = (n, d = 2) =>
  Number.isFinite(n) ? n.toLocaleString("th-TH", { minimumFractionDigits: d, maximumFractionDigits: d }) : "-";

let uid = 1;
const newId = () => uid++;

function fileToBase64(file) {
  return new Promise((resolve, reject) => {
    const r = new FileReader();
    r.onload = () => resolve(r.result.split(",")[1]);
    r.onerror = () => reject(new Error("อ่านไฟล์ไม่สำเร็จ"));
    r.readAsDataURL(file);
  });
}

async function readDimensionsFromImage(base64, mediaType) {
  const prompt =
    "อ่านภาพแบบเฟอร์นิเจอร์/งานตู้บิลท์อินนี้ ระบุขนาด กว้าง(มม) และ สูง(มม) ของทุกชิ้นงานที่ปรากฏในภาพ " +
    "ถ้ามีตัวเลขกำกับรหัสชิ้นงาน (ART) ให้ใส่ด้วย ถ้าไม่มีให้เว้นว่าง " +
    "ตอบกลับเป็น JSON array เท่านั้น ห้ามมีข้อความอื่นใดๆ หรือ markdown fence " +
    'รูปแบบ: [{"art":"","width":0,"height":0}]';

  const response = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      model: "claude-sonnet-5",
      max_tokens: 1000,
      messages: [
        {
          role: "user",
          content: [
            { type: "image", source: { type: "base64", media_type: mediaType, data: base64 } },
            { type: "text", text: prompt },
          ],
        },
      ],
    }),
  });

  if (!response.ok) throw new Error("เรียก AI ไม่สำเร็จ");
  const data = await response.json();
  const text = (data.content || [])
    .filter((b) => b.type === "text")
    .map((b) => b.text)
    .join("\n")
    .replace(/```json|```/g, "")
    .trim();

  const parsed = JSON.parse(text);
  if (!Array.isArray(parsed)) throw new Error("รูปแบบผลลัพธ์ไม่ถูกต้อง");
  return parsed
    .map((p) => ({
      art: (p.art || "").toString().trim(),
      width: Number(p.width) || 0,
      height: Number(p.height) || 0,
    }))
    .filter((p) => p.width > 0 && p.height > 0);
}

function UnitCard({ title, unit, qty, setQty, convertFactor, convertLabel }) {
  const converted = convertFactor ? qty * convertFactor : qty;
  const buffer = converted * 0.3;
  const order = roundup(converted + buffer * 1.1);
  return (
    <div className="unit-card">
      <div className="unit-head">
        <span className="unit-title">{title}</span>
        <span className="unit-pill">{unit}</span>
      </div>
      <label className="unit-field">
        <span>จำนวนไม้ (แผ่น)</span>
        <input
          type="number"
          min="0"
          value={qty}
          onChange={(e) => setQty(Number(e.target.value) || 0)}
        />
      </label>
      {convertFactor ? (
        <div className="unit-row">
          <span>แปลงหน่วย (×{convertFactor})</span>
          <span>{fmt(converted)}</span>
        </div>
      ) : null}
      <div className="unit-row">
        <span>เผื่อไม้ 30%</span>
        <span>{fmt(buffer)}</span>
      </div>
      <div className="unit-order">
        <span>จำนวนที่ต้องสั่ง</span>
        <strong>
          {order} <em>{convertLabel || unit}</em>
        </strong>
      </div>
    </div>
  );
}

export default function WoodCalculator() {
  const [mode, setMode] = useState("4x8");
  const [items, setItems] = useState([]);
  const [pending, setPending] = useState([]);
  const [analyzing, setAnalyzing] = useState(false);
  const [error, setError] = useState("");
  const [qtyPC, setQtyPC] = useState(0);
  const [qtyM, setQtyM] = useState(0);
  const [qtyM2, setQtyM2] = useState(0);
  const [syncedOnce, setSyncedOnce] = useState(false);
  const fileInputRef = useRef(null);

  const modeInfo = MODES[mode];

  const rows = useMemo(
    () => items.map((it) => ({ ...it, sqm: ((it.width * it.height) / 1_000_000) * (it.qty || 1) })),
    [items]
  );
  const totalSqm = useMemo(() => rows.reduce((s, r) => s + r.sqm, 0), [rows]);
  const sheetCount = useMemo(
    () => (totalSqm > 0 ? roundup((totalSqm / modeInfo.area) * 1.1) : 0),
    [totalSqm, modeInfo.area]
  );

  const syncQty = useCallback((n) => {
    setQtyPC(n);
    setQtyM(n);
    setQtyM2(n);
  }, []);

  const onFiles = async (fileList) => {
    const files = Array.from(fileList).filter((f) => f.type.startsWith("image/"));
    if (!files.length) return;
    setError("");
    const previews = await Promise.all(
      files.map(async (f) => ({ id: newId(), name: f.name, url: URL.createObjectURL(f), file: f, status: "queued" }))
    );
    setPending((p) => [...p, ...previews]);
    setAnalyzing(true);

    for (const preview of previews) {
      setPending((p) => p.map((x) => (x.id === preview.id ? { ...x, status: "reading" } : x)));
      try {
        const base64 = await fileToBase64(preview.file);
        const mediaType = preview.file.type || "image/jpeg";
        const found = await readDimensionsFromImage(base64, mediaType);
        if (!found.length) {
          setPending((p) => p.map((x) => (x.id === preview.id ? { ...x, status: "empty" } : x)));
          continue;
        }
        setItems((prev) => [
          ...prev,
          ...found.map((f) => ({ id: newId(), art: f.art || "-", width: f.width, height: f.height, qty: 1 })),
        ]);
        setPending((p) => p.map((x) => (x.id === preview.id ? { ...x, status: "done" } : x)));
      } catch (e) {
        setPending((p) => p.map((x) => (x.id === preview.id ? { ...x, status: "error" } : x)));
        setError("อ่านขนาดจากบางภาพไม่สำเร็จ กรุณาตรวจสอบหรือกรอกขนาดเองในตาราง");
      }
    }
    setAnalyzing(false);
  };

  const addRow = () => setItems((p) => [...p, { id: newId(), art: "-", width: 0, height: 0, qty: 1 }]);
  const removeRow = (id) => setItems((p) => p.filter((r) => r.id !== id));
  const updateRow = (id, field, value) =>
    setItems((p) => p.map((r) => (r.id === id ? { ...r, [field]: field === "art" ? value : Number(value) || 0 } : r)));
  const removePending = (id) => setPending((p) => p.filter((x) => x.id !== id));
  const clearAll = () => {
    setItems([]);
    setPending([]);
    setError("");
  };
  const resetAll = () => {
    setItems([]);
    setPending([]);
    setError("");
    setQtyPC(0);
    setQtyM(0);
    setQtyM2(0);
    setSyncedOnce(false);
  };

